{
  "description": "Collect Codex Companion Task chats into their sidebar section as reviews finish.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/janitor.sh\" collect >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/janitor.sh\" collect >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
